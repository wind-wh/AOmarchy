<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Traditional Chinese mirrors values-zh except for the shortcut_* labels, which only exist in values and
         values-zh (added later and intentionally not backfilled here); the launcher falls back to the default. -->

    <!-- Settings notification (MainActivity.showSettingsNotification; notification_switch/hint are legacy row labels
         kept together with the rest of the notification_* group) -->
    <string name="notification_switch">顯示設定通知</string>
    <string name="notification_hint">應用程式開啟時顯示一則常駐通知，其點按和按鈕回應可在下方設定。關閉後不再顯示。下次返回應用程式時生效。</string>
    <string name="notification_channel_name">AOmarchy</string>
    <string name="notification_channel_desc">AOmarchy 快速存取</string>
    <string name="notification_title">AOmarchy</string>
    <string name="notification_text">點按或下拉以使用已設定的操作</string>
    <string name="notification_action_preferences">設定</string>
    <string name="notification_action_exit">結束</string>
    <string name="notification_action_restart">重新啟動</string>
    <string name="notification_action_toggle_ime">切換輸入法</string>
    <string name="notification_action_toggle_extra_keys">切換擴充按鍵</string>
    <string name="notification_action_release_captures">釋放擷取</string>
    <string name="notification_action_touchpad_mode">觸控板模式</string>
    <string name="notification_action_screen_orientation">螢幕方向</string>

    <!-- Desktop toasts (MainActivity) -->
    <string name="toast_touchpad_mode_relative">觸控板模式已切換為相對模式</string>
    <string name="toast_touchpad_mode_absolute">觸控板模式已切換為絕對模式</string>
    <string name="toast_screen_orientation">螢幕方向已切換為%1$s</string>

    <!-- Labels for the screen_orientation preference (MainActivity.toggleScreenOrientation) -->
    <string-array name="screen_orientation_labels">
        <item>自動</item>
        <item>直向</item>
        <item>橫向</item>
        <item>反向直向</item>
        <item>反向橫向</item>
    </string-array>
</resources>
