        android:pathData="M7,7 L11,12 L7,17"
        android:strokeColor="#5FE1B4"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeWidth="2" />
    <path
        android:pathData="M13.5,17 H18"
        android:strokeColor="#7C8CFF"
        android:strokeLineCap="round"
        android:strokeWidth="2" />
