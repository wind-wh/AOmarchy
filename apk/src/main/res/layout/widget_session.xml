<?xml version="1.0" encoding="utf-8"?>
<!-- Home-screen widget body (SessionWidget): one status line + the 控制台 / 终端 entries.
     RemoteViews supports only a small view set, so this stays a plain LinearLayout/TextView layout. Colours are
     @color references so the widget follows the single brand palette in values/colors.xml instead of drifting
     out of sync (bg is too dark for a launcher card: brand_surface #14171F is used). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_surface"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/widget_status"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:maxLines="2"
        android:text="@string/widget_label"
        android:textColor="@color/brand_text"
        android:textSize="15sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_console"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@color/brand_surface_hi"
            android:gravity="center"
            android:text="@string/widget_btn_console"
            android:textColor="@color/brand_text"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/widget_terminal"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@color/brand_accent"
            android:gravity="center"
            android:text="@string/widget_btn_terminal"
            android:textColor="@color/brand_bg"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
